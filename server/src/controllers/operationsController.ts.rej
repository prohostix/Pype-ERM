+
+export const updateCenterOpsSubAdmin = asyncHandler(async (req: AuthRequest, res: Response) => {
+  const { opsSubAdminId } = req.body;
+  await prisma.programAllocation.updateMany({ where: { centerId: req.params.id }, data: { opsSubAdminId: opsSubAdminId || null } });
+  res.json({ success: true, message: 'Assigned Ops Sub-Admin updated' });
+});
