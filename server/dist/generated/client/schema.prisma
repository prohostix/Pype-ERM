  @@index([universityId])
}

model UniversityCommission {
  id             String       @id @default(uuid())
  organizationId String
  studentId      String
  universityId   String
  amountReceived Float
  dateReceived   DateTime     @default(now())
  status         String       @default("pending")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id])
  university     University   @relation(fields: [universityId], references: [id])
}

model EnrollmentPayment {
  id            String             @id @default(uuid())
  enrollmentId  String             @unique
  studyCenterId String?
  walletId      String?
  amount        Float
  debitedAt     DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  enrollment    Enrollment         @relation(fields: [enrollmentId], references: [id])
  studyCenter   StudyCenter?       @relation(fields: [studyCenterId], references: [id])
  wallet        StudyCenterWallet? @relation(fields: [walletId], references: [id])

  @@index([studyCenterId])
}

model IncentiveStructure {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  targetType     String
  applicableTo   String
  tiers          Json         @default("[]")
  period         String
  status         String       @default("draft")
  approvedBy     String?
  approvedAt     DateTime?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  approver       User?        @relation("IncentiveApprovedBy", fields: [approvedBy], references: [id])
  creator        User         @relation("IncentiveCreatedBy", fields: [createdBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model ProgramMaterial {
  id             String       @id @default(uuid())
  programId      String
  organizationId String
  title          String
  description    String?
  fileUrl        String
  uploadedBy     String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program        Program      @relation(fields: [programId], references: [id])
  uploader       User         @relation("MaterialUploadedBy", fields: [uploadedBy], references: [id])

  @@index([programId])
  @@index([organizationId])
}

model PaymentSchedule {
  id             String        @id @default(uuid())
  organizationId String
  studentId      String
  title          String
  amount         Float
  dueDate        DateTime
  status         String        @default("pending")
  paidAt         DateTime?
  remarks        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isOldFee       Boolean       @default(false)
  isExtraFee     Boolean       @default(false)
  invoices       Invoice[]
  paymentLinks   PaymentLink[]
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([studentId])
}

model PaymentLink {
  id             String           @id @default(uuid())
  organizationId String
  studentId      String
  scheduleId     String?
  invoiceId      String?
  token          String           @unique @default(uuid())
  amount         Float
  description    String?
  status         String           @default("active")
  expiresAt      DateTime
  paidAt         DateTime?
  createdBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  creator        User?            @relation("PaymentLinkCreatedBy", fields: [createdBy], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule       PaymentSchedule? @relation(fields: [scheduleId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])

  @@index([organizationId])
  @@index([studentId])
  @@index([token])
}

model CollectionOverseer {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model OrgInquiry {
  id        String   @id @default(uuid())
  orgName   String
  adminName String
  email     String
  phone     String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model UniversityPayment {
  id             String       @id @default(uuid())
  organizationId String
  studentId      String
  universityId   String
  amountPaid     Float
  datePaid       DateTime     @default(now())
  status         String       @default("paid")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id])
  university     University   @relation(fields: [universityId], references: [id])
}

model Asset {
  id              String      @id @default(uuid())
  type            AssetType
  brand           String?
  model           String?
  serialNumber    String?
  imeiNumber      String?
  networkProvider String?
  phoneNumber     String?
  userId          String
  status          AssetStatus @default(ASSIGNED)
  notes           String?
  assignedDate    DateTime    @default(now())
  returnedDate    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation("UserAssets", fields: [userId], references: [id])
}

model DocumentLog {
  id             String    @id @default(uuid())
  organizationId String
  studentId      String?
  type           String    @default("received")
  documentName   String
  documentType   String
  status         String    @default("pending")
  notes          String?
  courierName    String?
  trackingNumber String?
  dispatchDate   DateTime?
  deliveryDate   DateTime?
  loggedBy       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  loggedByUser   User      @relation("DocumentLoggedBy", fields: [loggedBy], references: [id])
  student        Student?  @relation(fields: [studentId], references: [id])

  @@index([organizationId])
  @@index([studentId])
}

